<Window x:Class="DismRepairCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DISM Repair Center" Width="820" Height="540" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="icon.ico" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Header -->
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
      <Image Source="icon.ico" Width="30" Height="30" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock x:Name="OsInfo" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <Button x:Name="LangBtn" Style="{StaticResource SmallButton}" Click="Lang_Click" MinWidth="40"/>
      </StackPanel>
      <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="DISM Repair Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DockPanel>

    <!-- Left: actions -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0" Focusable="False">
      <StackPanel x:Name="LeftPanel" Margin="0,0,2,0">
        <Button x:Name="FullBtn" Style="{StaticResource PrimaryButton}" Tag="full" Click="Action_Click"
                Margin="2,0,2,4" HorizontalContentAlignment="Center">
          <TextBlock x:Name="FullTitle" FontWeight="SemiBold"/>
        </Button>
        <StackPanel x:Name="Actions"/>
        <Expander x:Name="OptExpander" Margin="2,6,2,0" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold">
          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="6" Padding="8,7" Margin="0,4,0,0">
            <StackPanel TextElement.FontSize="12" TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource Ink}">
              <CheckBox x:Name="ResetBase" Margin="0,0,0,6">
                <TextBlock x:Name="ResetBaseTxt"/>
              </CheckBox>
              <TextBlock x:Name="SourceLbl" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3"/>
              <DockPanel>
                <Button x:Name="BrowseSrc" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="…" Click="BrowseSource_Click"/>
                <TextBox x:Name="SourceBox" Padding="4,2" VerticalContentAlignment="Center"/>
              </DockPanel>
              <CheckBox x:Name="LimitAccess" Margin="0,6,0,0">
                <TextBlock x:Name="LimitAccessTxt"/>
              </CheckBox>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: output -->
    <Border Grid.Row="1" Grid.Column="1" Background="#14171D" CornerRadius="7" Padding="3">
      <TextBox x:Name="Output" IsReadOnly="True" Background="Transparent" Foreground="#DDE1E7" BorderThickness="0"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Padding="6"
               VerticalScrollBarVisibility="Auto" IsReadOnlyCaretVisible="False"/>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Status" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="Progress" Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
        <Button x:Name="CancelBtn" Style="{StaticResource SmallButton}" Click="Cancel_Click" IsEnabled="False"/>
        <Button x:Name="SaveBtn" Style="{StaticResource SmallButton}" Click="Save_Click"/>
        <Button x:Name="ClearBtn" Style="{StaticResource SmallButton}" Click="Clear_Click"/>
        <Button x:Name="ExitBtn" Style="{StaticResource SmallButton}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
