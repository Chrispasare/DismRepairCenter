<Window x:Class="DismRepairCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DISM Repair Center" Width="680" Height="520" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="icon.ico" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="70"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,6">
      <Image Source="icon.ico" Width="28" Height="28" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock x:Name="OsInfo" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <Button x:Name="LangBtn" Style="{StaticResource SmallButton}" Click="Lang_Click" MinWidth="40"/>
      </StackPanel>
      <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="DISM Repair Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DockPanel>

    <!-- Actions: three columns -->
    <StackPanel x:Name="LeftPanel" Grid.Row="1" Margin="-2,0,-2,6">
      <Button x:Name="FullBtn" Style="{StaticResource PrimaryButton}" Tag="full" Click="Action_Click"
              HorizontalContentAlignment="Center">
        <TextBlock x:Name="FullTitle" FontWeight="SemiBold"/>
      </Button>
      <UniformGrid x:Name="Actions" Columns="3"/>
      <Expander x:Name="OptExpander" Margin="2,4,2,0" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
          <Grid TextElement.FontSize="12" TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource Ink}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="SourceLbl" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SourceBox" Grid.Column="1" Padding="4,2" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseSrc" Grid.Column="2" Style="{StaticResource SmallButton}" Content="…" Click="BrowseSource_Click"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
              <CheckBox x:Name="LimitAccess" Margin="0,0,18,0">
                <TextBlock x:Name="LimitAccessTxt"/>
              </CheckBox>
              <CheckBox x:Name="ResetBase">
                <TextBlock x:Name="ResetBaseTxt"/>
              </CheckBox>
            </StackPanel>
          </Grid>
        </Border>
      </Expander>
    </StackPanel>

    <!-- Output -->
    <Border Grid.Row="2" Background="#14171D" CornerRadius="7" Padding="3">
      <TextBox x:Name="Output" IsReadOnly="True" Background="Transparent" Foreground="#DDE1E7" BorderThickness="0"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Padding="6"
               VerticalScrollBarVisibility="Auto" IsReadOnlyCaretVisible="False"/>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Status" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="Progress" Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
        <Button x:Name="CancelBtn" Style="{StaticResource SmallButton}" Click="Cancel_Click" IsEnabled="False"/>
        <Button x:Name="SaveBtn" Style="{StaticResource SmallButton}" Click="Save_Click"/>
        <Button x:Name="ClearBtn" Style="{StaticResource SmallButton}" Click="Clear_Click"/>
        <Button x:Name="ExitBtn" Style="{StaticResource SmallButton}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
