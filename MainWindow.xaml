<Window x:Class="DismRepairCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DISM Repair Center" Width="1040" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="icon.ico" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Header -->
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
      <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource Accent}" DockPanel.Dock="Left">
        <Image Source="icon.ico" Width="40" Height="40"/>
      </Border>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock x:Name="OsInfo" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button x:Name="LangBtn" Style="{StaticResource SmallButton}" Click="Lang_Click" MinWidth="48"/>
      </StackPanel>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="DISM Repair Center" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>

    <!-- Left: actions -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0" Focusable="False">
      <StackPanel x:Name="LeftPanel" Margin="0,0,6,0">
        <Button x:Name="FullBtn" Style="{StaticResource PrimaryButton}" Tag="full" Click="Action_Click" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="FullTitle" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="FullDesc" TextWrapping="Wrap" Opacity="0.9" FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <StackPanel x:Name="Actions"/>
        <TextBlock x:Name="OptTitle" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,8,0,6"/>
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="12,10">
          <StackPanel>
            <CheckBox x:Name="ResetBase" Margin="0,0,0,8">
              <TextBlock x:Name="ResetBaseTxt" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock x:Name="SourceLbl" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
            <DockPanel>
              <Button x:Name="BrowseSrc" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="…" Click="BrowseSource_Click"/>
              <TextBox x:Name="SourceBox" Padding="5,4" VerticalContentAlignment="Center"/>
            </DockPanel>
            <CheckBox x:Name="LimitAccess" Margin="0,8,0,0">
              <TextBlock x:Name="LimitAccessTxt" TextWrapping="Wrap"/>
            </CheckBox>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Credit" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: output -->
    <Border Grid.Row="1" Grid.Column="1" Background="#14171D" CornerRadius="8" Padding="4">
      <TextBox x:Name="Output" IsReadOnly="True" Background="Transparent" Foreground="#DDE1E7" BorderThickness="0"
               FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" Padding="8"
               VerticalScrollBarVisibility="Auto" IsReadOnlyCaretVisible="False"/>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Status" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100"
                     Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
        <Button x:Name="CancelBtn" Style="{StaticResource SmallButton}" Click="Cancel_Click" IsEnabled="False"/>
        <Button x:Name="SaveBtn" Style="{StaticResource SmallButton}" Click="Save_Click"/>
        <Button x:Name="ClearBtn" Style="{StaticResource SmallButton}" Click="Clear_Click"/>
        <Button x:Name="ExitBtn" Style="{StaticResource SmallButton}" Click="Exit_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
